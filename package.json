{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@kuro-bridge/protocol",
    "version": "0.4.0",
    "packageManager": "pnpm@11.21.0",
    "description": "kurobridge-ws 协议的家：zod schema SSOT + 规格书 + 金样本夹具（包版本 ≡ 协议版本）",
    "type": "module",
    "license": "MIT",
    "files": [
        "dist",
        "fixtures",
        "scripts/verify-fixtures.mjs"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "bin": {
        "kuro-bridge-verify-fixtures": "scripts/verify-fixtures.mjs"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check . && tsc --noEmit",
        "fix": "biome check --write . && tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "verify:fixtures": "node scripts/verify-fixtures.mjs"
    },
    "dependencies": {
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "tsdown": "^0.22.14",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
