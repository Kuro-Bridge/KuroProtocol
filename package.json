{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@kuro-bridge/protocol",
    "version": "0.4.0",
    "packageManager": "pnpm@11.21.0",
    "description": "kurobridge-ws 协议的家：zod schema SSOT + 规格书 + 金样本夹具（包版本 ≡ 协议版本）",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Kuro-Bridge/KuroProtocol.git"
    },
    "files": [
        "dist",
        "fixtures",
        "scripts/verify-fixtures.ts"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "bin": {
        "kuro-bridge-verify-fixtures": "scripts/verify-fixtures.ts"
    },
    "engines": {
        "node": ">=22.18.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check . && tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
        "fix": "biome check --write . && tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "verify:fixtures": "node scripts/verify-fixtures.ts",
        "verify:version": "node scripts/assert-version.ts",
        "verify:docs": "node scripts/check-doc-links.ts",
        "verify:release": "node scripts/verify-release.ts",
        "verify:trust": "node scripts/verify-trust.ts",
        "gate": "pnpm check && pnpm test && pnpm build && pnpm verify:fixtures && pnpm verify:version && pnpm verify:docs"
    },
    "dependencies": {
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@types/node": "^26.6.1",
        "tsdown": "^0.22.14",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
